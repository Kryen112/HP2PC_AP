        case 43: return 5760189;
        case 44: return 5760146;
        case 45: return 5760171;
        case 46: return 5760112;
        case 47: return 5760132;
        case 48: return 5760200;
        case 49: return 5760117;
        case 50: return 5760103;
        case 51: return 5760110;
        case 52: return 5760180;
        case 53: return 5760108;
        case 54: return 5760177;
        case 55: return 5760170;
        case 56: return 5760157;
        case 57: return 5760122;
        case 58: return 5760115;
        case 59: return 5760163;
