        case 21: return 5760148;
        case 22: return 5760153;
        case 23: return 5760152;
        case 24: return 5760141;
        case 25: return 5760111;
        case 26: return 5760129;
        case 27: return 5760174;
        case 28: return 5760137;
        case 29: return 5760101;
        case 30: return 5760166;
        case 31: return 5760105;
        case 32: return 5760145;
        case 33: return 5760118;
        case 34: return 5760183;
