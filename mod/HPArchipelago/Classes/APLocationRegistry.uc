        if (MarkerName == "GFemSly4") return 5760804;
        if (MarkerName == "GMaleSly2") return 5760805;
        if (MarkerName == "GOldMaleGry0") return 5760800;
        if (MarkerName == "GOldMaleGry3") return 5760803;
        if (MarkerName == "GOldMaleSly2") return 5760801;
    }
