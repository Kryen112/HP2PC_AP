# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/

# UnrealScript build artifacts. The one exception is the canonical compiled
# package: exactly one HPArchipelago.u ships per release, committed next to
# its source-hash manifest and verified by build_apworld.py.
*.u
!/mod/Compiled/HPArchipelago.u
*.tmp
*.log

# Mod package staged into the apworld by build_apworld.py. The canonical
# copy is mod/Compiled.
/apworld/data/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# AP generation
output/
dist-temp/
*.archipelago
tmp_seed_check*/
dist/

# Local dev tools stay out of the repo. The wand and ghost glasses generators
# are committed as the record that those assets are drawn from plain shapes;
# the baked outputs live under mod/HPArchipelago.
tools/*.py
!tools/gen_wand_mesh.py
!tools/gen_ghost_glasses.py
tools/*.png

# Local configs
.env
*.local.yaml

/plans/
